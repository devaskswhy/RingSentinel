# ============================================================================
# RingSentinel - environment template
#
# Copy to .env before running anything:   cp .env.example .env
# The defaults below are enough to run `docker compose up` with no edits.
# .env is gitignored; never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Postgres
# Where to get it: you choose these. They are created on first `docker compose
# up` inside the local container - they are NOT credentials from any provider.
# ---------------------------------------------------------------------------
POSTGRES_USER=ringsentinel
POSTGRES_PASSWORD=ringsentinel
POSTGRES_DB=ringsentinel
# Host port to publish Postgres on. This is ONLY for connecting from your own
# machine (psql, a GUI client) - the backend talks to Postgres over the compose
# network as `db:5432` regardless of this value.
# Defaults to 5434 rather than 5432 because the standard port very often
# collides with another local Postgres or another project's container.
POSTGRES_PORT=5434

# Only needed when running the backend on your host instead of in Docker.
# Inside Docker the host is `db`; from your host machine it is `localhost`.
# DATABASE_URL=postgresql+psycopg://ringsentinel:ringsentinel@localhost:5434/ringsentinel

# ---------------------------------------------------------------------------
# Service ports and app config
# Where to get it: your choice. Change only on a port conflict.
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_ENV=local
LOG_LEVEL=info
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Razorpay - TEST MODE ONLY (needed from Phase 2 onward)
#
# Where to get it: Razorpay Dashboard -> toggle the account into "Test Mode"
# -> Account & Settings -> API Keys -> Generate Test Key.
#   https://dashboard.razorpay.com/app/website-app-settings/api-keys
#
# The key id MUST start with "rzp_test_". The backend refuses to treat a key
# without that prefix as valid (see app/config.py). Never put a live key
# (rzp_live_...) in this file or anywhere in this repo.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Where to get it: Razorpay Dashboard -> Settings -> Webhooks -> create a
# webhook -> the secret you set there. Used to verify webhook signatures.
#
# For LOCAL SEEDING this can be any value you like. Razorpay cannot reach
# localhost, so `scripts.seed_rings` signs the events it replays with this same
# secret and posts them to your own /webhooks/razorpay. The receiver refuses
# unsigned events outright, so it must be set to something.
#   generate one:  python -c "import secrets; print('whsec_local_'+secrets.token_hex(16))"
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Claude Agent SDK (needed from Phase 4 onward)
#
# The SDK authenticates through a bundled Claude Code binary, NOT an API key
# parameter. Credential resolution order:
#   1. ANTHROPIC_API_KEY           -> pay-as-you-go API billing (not used here)
#   2. CLAUDE_CODE_OAUTH_TOKEN     -> subscription OAuth, works headless/Docker
#   3. ~/.claude/.credentials.json -> interactive `claude` login on the host
#
# Where to get it: run `claude setup-token` on your machine and paste the
# printed token below. This bills against your Claude subscription rather than
# API credit, which is what this project wants.
#
# Verify it works with:
#   docker compose exec backend python -m scripts.verify_claude_auth
#
# NOTE: Anthropic does not permit shipping a product that authenticates OTHER
# users through claude.ai login. This token is for local development and the
# demo only. A deployed multi-user RingSentinel needs ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative to CLAUDE_CODE_OAUTH_TOKEN: point the container at your existing
# host Claude login instead of minting a token. The backend bind-mounts this
# directory to /root/.claude. Read-write, because the CLI refreshes the token in
# place. Leave unset if you are using CLAUDE_CODE_OAUTH_TOKEN.
#   macOS/Linux:  CLAUDE_CONFIG_HOST_DIR=/home/you/.claude
#   Windows:      CLAUDE_CONFIG_HOST_DIR=C:/Users/you/.claude
CLAUDE_CONFIG_HOST_DIR=

# Alternative to the above if you ever move to API billing.
# Where to get it: https://platform.claude.com/ -> API Keys
#
# Deliberately NOT passed through in docker-compose.yml, so it cannot be picked
# up by accident and silently switch this project onto pay-as-you-go billing.
# Wiring it up is a conscious edit to docker-compose.yml, not just a .env line.
# ANTHROPIC_API_KEY=
